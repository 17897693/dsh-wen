{
  "name": "dsh-wen",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-wen",
    "office",
    "docx",
    "xlsx",
    "pptx",
    "pdf",
    "odt",
    "csv",
    "html",
    "ocr"
  ],
  "description": "DSH system-level Office all-in-one plugin: read/create/edit/convert docx, xlsx, pptx, pdf, odf, csv and legacy OLE2 formats with zero third-party dependencies.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./skill": "./skill.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./skill/package.json": "./package.json",
    "./skill/locale/en.json": "./locale/en.json",
    "./skill/locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "index.js",
    "skill.js",
    "*.js",
    "pdf-render.ps1",
    "locale/",
    "vendor/",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.mjs"
  }
}
